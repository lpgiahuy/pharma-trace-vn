model order_package_items {
  id             Int            @id @default(autoincrement())
  package_id     Int
  order_item_id  Int
  box_uid        String         @db.Uuid
  voided_at      DateTime?      @db.Timestamptz(6)
  order_packages order_packages @relation(fields: [package_id], references: [id], onUpdate: NoAction)
  order_items    order_items    @relation(fields: [order_item_id], references: [id], onUpdate: NoAction)
  medicine_boxes medicine_boxes @relation(fields: [box_uid], references: [uid], onUpdate: NoAction)

  @@index([package_id], map: "idx_order_package_items_package")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model carrier_handovers {
  id                Int                         @id @default(autoincrement())
  handover_code     String                      @unique @db.VarChar(50)
  facility_id       Int
  courier_name      String                      @db.VarChar(100)
  driver_name       String?                     @db.VarChar(100)
  driver_phone      String?                     @db.VarChar(30)
  vehicle_plate     String?                     @db.VarChar(20)
  note              String?
  handed_over_by_id Int
  handed_over_at    DateTime                    @default(now()) @db.Timestamptz(6)
  facility          facilities                  @relation(fields: [facility_id], references: [id], onUpdate: NoAction)
  handed_over_by    employees                   @relation(fields: [handed_over_by_id], references: [id], onUpdate: NoAction)
  packages          carrier_handover_packages[]

  @@index([facility_id, handed_over_at(sort: Desc)], map: "idx_carrier_handovers_facility")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model carrier_handover_packages {
  handover_id Int
  package_id  Int               @unique
  handover    carrier_handovers @relation(fields: [handover_id], references: [id], onUpdate: NoAction)
  package     order_packages    @relation(fields: [package_id], references: [id], onUpdate: NoAction)

  @@id([handover_id, package_id])
}
