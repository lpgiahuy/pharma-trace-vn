generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model categories {
  id                  Int                   @id @default(autoincrement())
  category_name       String                @db.VarChar(100)
  slug                String?               @unique @db.VarChar(100)
  description         String?
  icon                String?               @db.VarChar(100)
  parent_id           Int?
  display_order       Int?                  @default(0)
  status              String?               @default("ACTIVE") @db.VarChar(50)
  parent              categories?           @relation("category_hierarchy", fields: [parent_id], references: [id], onUpdate: NoAction)
  children            categories[]          @relation("category_hierarchy")
  medicine_categories medicine_categories[]
}

model facilities {
  id                       Int                          @id @default(autoincrement())
  facility_name            String                       @db.VarChar(150)
  facility_type            String                       @db.VarChar(50)
  address                  String?
  phone_number             String?                      @db.VarChar(20)
  email                    String?                      @db.VarChar(100)
  latitude                 Decimal?                     @db.Decimal(10, 7)
  longitude                Decimal?                     @db.Decimal(10, 7)
  created_at               DateTime?                    @default(now()) @db.Timestamptz(6)
  accounts_payable         accounts_payable[]
  batches                  batches[]
  employees                employees[]
  inventories              inventories[]
  inventory_logs           inventory_logs[]
  medicine_boxes           medicine_boxes[]
  orders                   orders[]
  purchase_orders_supplier purchase_orders[]            @relation("po_supplier")
  purchase_orders_received purchase_orders[]            @relation("po_facility")
  sscc_cartons             sscc_cartons[]
  transfers_from           internal_transfers[]         @relation("transfers_from")
  transfers_to             internal_transfers[]         @relation("transfers_to")
  stock_requests_from      stock_transfer_requests[]    @relation("stock_requests_from")
  stock_requests_to        stock_transfer_requests[]    @relation("stock_requests_to")
  order_items_sourced      order_items[]                @relation("order_items_source_facility")
  prescription_reviews     order_prescription_reviews[]
  goods_receipts           goods_receipts[]             @relation("gr_facility")
  order_packages           order_packages[]
  carrier_handovers        carrier_handovers[]
}

model customers {
  id                    Int                     @id @default(autoincrement())
  membership_tier       String?                 @default("BRONZE") @db.VarChar(50)
  reward_points         Int?                    @default(0)
  default_address       String?
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  full_name             String?                 @db.VarChar(100)
  phone_number          String?                 @unique @db.VarChar(20)
  email                 String?                 @unique @db.VarChar(100)
  password_hash         String?                 @db.VarChar(255)
  status                String?                 @default("ACTIVE") @db.VarChar(20)
  accounts_receivable   accounts_receivable[]
  cart_items            cart_items[]
  loyalty_point_logs    loyalty_point_logs[]
  orders                orders[]
  prescriptions         prescriptions[]
  qr_scan_logs          qr_scan_logs[]
  reviews               reviews[]
  wishlists             customer_wishlists[]
  moderation_reports    moderation_reports[]    @relation("report_reporter_customer")
  moderation_audit_logs moderation_audit_logs[] @relation("audit_customer")
}

model employees {
  id                        Int                          @id @default(autoincrement())
  facility_id               Int?
  job_title                 String?                      @db.VarChar(100)
  joined_date               DateTime?                    @default(dbgenerated("CURRENT_DATE")) @db.Date
  full_name                 String?                      @db.VarChar(100)
  email                     String?                      @unique @db.VarChar(100)
  password_hash             String?                      @db.VarChar(255)
  role                      String?                      @db.VarChar(50)
  status                    String?                      @default("ACTIVE") @db.VarChar(20)
  created_at                DateTime?                    @default(now()) @db.Timestamptz(6)
  articles                  articles[]
  cashbook_logs             cashbook_logs[]
  facilities                facilities?                  @relation(fields: [facility_id], references: [id], onUpdate: NoAction)
  inventory_logs            inventory_logs[]
  prescriptions             prescriptions[]
  prescription_reviews      order_prescription_reviews[]
  purchase_orders           purchase_orders[]
  purchase_orders_approved  purchase_orders[]            @relation("po_approver")
  purchase_order_events     purchase_order_events[]      @relation("po_event_actor")
  goods_receipts            goods_receipts[]             @relation("gr_receiver")
  packed_order_packages     order_packages[]             @relation("package_packer")
  voided_order_packages     order_packages[]             @relation("package_voider")
  carrier_handovers         carrier_handovers[]
  goods_receipt_attachments goods_receipt_attachments[]  @relation("gr_attachment_uploader")
  reported_moderations      moderation_reports[]         @relation("report_reporter_employee")
  resolved_moderations      moderation_reports[]         @relation("report_resolver_employee")
  moderation_audit_logs     moderation_audit_logs[]      @relation("audit_employee")
}

model medicines {
  id                            Int                    @id @default(autoincrement())
  medicine_name                 String                 @db.VarChar(255)
  registration_number           String?                @db.VarChar(100)
  active_ingredients            String?
  dosage                        String?                @db.VarChar(100)
  manufacturer                  String?                @db.VarChar(150)
  country_of_origin             String?                @db.VarChar(100)
  unit_price                    Decimal                @default(0) @db.Decimal(15, 2)
  promotional_price             Decimal?               @db.Decimal(15, 2)
  image_url                     String?
  short_description             String?
  details                       Json?                  @default("{}")
  is_prescription               Boolean?               @default(false)
  status                        String?                @default("ACTIVE") @db.VarChar(50)
  created_at                    DateTime?              @default(now()) @db.Timestamptz(6)
  effective_price               Decimal?               @default(dbgenerated("COALESCE(NULLIF(promotional_price, (0)::numeric), unit_price)")) @db.Decimal(15, 2)
  slug                          String?                @db.VarChar(255)
  manufacturer_id               Int?
  min_remaining_shelf_life_days Int?
  manufacturer_rel              manufacturers?         @relation(fields: [manufacturer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  batches                       batches[]
  inventory_logs                inventory_logs[]
  medicine_categories           medicine_categories[]
  order_items                   order_items[]
  packaging_variants            packaging_variants[]
  purchase_order_items          purchase_order_items[]
  reviews                       reviews[]
  wishlists                     customer_wishlists[]

  @@index([effective_price], map: "idx_medicines_effective_price")
  @@index([slug], map: "idx_medicines_slug")
  @@index([manufacturer_id], map: "idx_medicines_manufacturer_id")
}

model packaging_variants {
  id                   Int                    @id @default(autoincrement())
  medicine_id          Int
  unit_name            String                 @db.VarChar(50)
  price                Decimal                @default(0) @db.Decimal(15, 2)
  original_price       Decimal?               @db.Decimal(15, 2)
  discount_percent     Int?                   @default(0)
  is_base_unit         Boolean?               @default(false)
  sale_start_date      DateTime?              @db.Timestamptz(6)
  sale_end_date        DateTime?              @db.Timestamptz(6)
  sale_quantity        Int?
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  cart_items           cart_items[]
  inventories          inventories[]
  order_items          order_items[]
  medicine             medicines              @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchase_order_items purchase_order_items[]

  @@index([medicine_id], map: "idx_packaging_variants_medicine")
}

model medicine_categories {
  medicine_id Int
  category_id Int
  is_primary  Boolean    @default(false)
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  category    categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  medicine    medicines  @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([medicine_id, category_id])
  @@index([category_id], map: "idx_medicine_categories_cat_id")
  @@index([medicine_id], map: "idx_medicine_categories_med_id")
}

model medicine_boxes {
  uid                 String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  batch_id            Int?
  carton_id           Int?
  current_facility_id Int?
  status              String?               @default("IN_STOCK") @db.VarChar(50)
  signature           String?
  public_key          String?
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  fraud_alerts        fraud_alerts[]
  medicine_batches    batches?              @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sscc_cartons        sscc_cartons?         @relation(fields: [carton_id], references: [id], onUpdate: NoAction)
  facilities          facilities?           @relation(fields: [current_facility_id], references: [id], onUpdate: NoAction)
  qr_scan_logs        qr_scan_logs[]
  order_package_items order_package_items[]

  @@index([batch_id], map: "idx_medicine_boxes_batch_id")
  @@index([carton_id], map: "idx_medicine_boxes_carton_id")
  @@index([current_facility_id], map: "idx_medicine_boxes_facility_id")
  @@index([status], map: "idx_medicine_boxes_status")
}

model prescriptions {
  id                        Int                          @id @default(autoincrement())
  customer_id               Int?
  prescribing_doctor        String?                      @db.VarChar(100)
  medical_facility          String?                      @db.VarChar(150)
  diagnosis                 String?
  prescription_image_url    String?
  status                    String?                      @default("PENDING_APPROVAL") @db.VarChar(50)
  pharmacist_note           String?
  approved_by_pharmacist_id Int?
  prescribed_date           DateTime?                    @db.Date
  created_at                DateTime?                    @default(now()) @db.Timestamptz(6)
  orders                    orders[]
  order_reviews             order_prescription_reviews[]
  users                     employees?                   @relation(fields: [approved_by_pharmacist_id], references: [id], onUpdate: NoAction)
  customers                 customers?                   @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id], map: "idx_prescriptions_customer_id")
  @@index([status], map: "idx_prescriptions_status")
}

model vouchers {
  id                  Int       @id @default(autoincrement())
  voucher_code        String    @unique @db.VarChar(50)
  discount_type       String?   @default("PERCENT") @db.VarChar(20)
  discount_value      Decimal   @db.Decimal(15, 2)
  min_order_value     Decimal?  @default(0) @db.Decimal(15, 2)
  max_discount_amount Decimal?  @db.Decimal(15, 2)
  total_quantity      Int       @default(100)
  used_quantity       Int       @default(0)
  start_date          DateTime? @db.Timestamptz(6)
  end_date            DateTime? @db.Timestamptz(6)
  status              String?   @default("ACTIVE") @db.VarChar(50)
  orders              orders[]
}

model orders {
  id                         Int                         @id @default(autoincrement())
  voucher_id                 Int?
  voucher                    vouchers?                   @relation(fields: [voucher_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order_code                 String                      @unique @db.VarChar(50)
  customer_id                Int?
  export_facility_id         Int?
  prescription_id            Int?
  prescription_review_status String?                     @db.VarChar(30)
  subtotal_amount            Decimal                     @default(0) @db.Decimal(15, 2)
  shipping_fee               Decimal?                    @default(0) @db.Decimal(15, 2)
  discount_amount            Decimal?                    @default(0) @db.Decimal(15, 2)
  used_points                Int?                        @default(0)
  total_amount               Decimal                     @default(0) @db.Decimal(15, 2)
  payment_method             String?                     @default("COD") @db.VarChar(50)
  payment_status             String?                     @default("UNPAID") @db.VarChar(50)
  order_status               String?                     @default("PENDING") @db.VarChar(50)
  shipping_address           String?
  recipient_phone            String?                     @db.VarChar(20)
  recipient_name             String?                     @db.VarChar(100)
  note                       String?
  created_at                 DateTime?                   @default(now()) @db.Timestamptz(6)
  accounts_receivable        accounts_receivable[]
  cashbook_logs              cashbook_logs[]
  loyalty_point_logs         loyalty_point_logs[]
  order_items                order_items[]
  customers                  customers?                  @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  facilities                 facilities?                 @relation(fields: [export_facility_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prescriptions              prescriptions?              @relation(fields: [prescription_id], references: [id], onUpdate: NoAction)
  prescription_review        order_prescription_reviews?
  shipments                  shipments?
  internal_transfers         internal_transfers[]
  order_packages             order_packages[]

  @@index([customer_id], map: "idx_orders_customer_id")
  @@index([order_status], map: "idx_orders_status")
  @@index([created_at], map: "idx_orders_created_at")
  @@index([voucher_id], map: "idx_orders_voucher_id")
}

model order_prescription_reviews {
  id              Int           @id @default(autoincrement())
  order_id        Int           @unique
  prescription_id Int
  status          String        @default("PENDING_APPROVAL") @db.VarChar(30)
  pharmacist_id   Int?
  facility_id     Int
  note            String?
  reviewed_at     DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  order           orders        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  prescription    prescriptions @relation(fields: [prescription_id], references: [id], onDelete: Restrict)
  pharmacist      employees?    @relation(fields: [pharmacist_id], references: [id], onDelete: SetNull)
  facility        facilities    @relation(fields: [facility_id], references: [id], onDelete: Restrict)

  @@index([facility_id, status, created_at], map: "idx_order_prescription_reviews_queue")
  @@index([prescription_id], map: "idx_order_prescription_reviews_prescription")
}

model order_items {
  id                  Int                   @id @default(autoincrement())
  order_id            Int?
  medicine_id         Int?
  variant_id          Int?
  medicine_name       String?               @db.VarChar(255)
  unit_name           String?               @db.VarChar(50)
  quantity            Int                   @default(1)
  unit_price          Decimal               @default(0) @db.Decimal(15, 2)
  total_price         Decimal               @default(0) @db.Decimal(15, 2)
  assigned_uids       String[]              @default([]) @db.Uuid
  inventory_reserved  Boolean               @default(false)
  source_facility_id  Int?
  packaging_variants  packaging_variants?   @relation(fields: [variant_id], references: [id], onUpdate: NoAction, map: "fk_order_items_variant")
  medicines           medicines?            @relation(fields: [medicine_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders              orders?               @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  source_facility     facilities?           @relation("order_items_source_facility", fields: [source_facility_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  order_package_items order_package_items[]
}

model internal_transfers {
  id                      Int       @id @default(autoincrement())
  transfer_code           String    @unique @db.VarChar(50)
  order_id                Int?
  transfer_type           String    @default("ORDER_FULFILLMENT") @db.VarChar(30)
  request_id              Int?      @unique
  from_facility_id        Int
  to_facility_id          Int
  status                  String    @default("REQUESTED") @db.VarChar(50)
  items                   Json      @default("[]")
  tracking_code           String?   @db.VarChar(100)
  transport_mode          String?   @db.VarChar(20)
  transport_employee_id   Int?
  transport_employee_name String?   @db.VarChar(150)
  courier_name            String?   @db.VarChar(100)
  distance_km             Decimal?  @db.Decimal(10, 2)
  estimated_hours         Int?      @default(24)
  notes                   String?
  variance_details        Json?     @default("{}")
  return_reason           String?
  returned_at             DateTime? @db.Timestamptz(6)
  discrepancy_status      String?   @default("NONE") @db.VarChar(50)
  dispatched_at           DateTime? @db.Timestamptz(6)
  received_at             DateTime? @db.Timestamptz(6)
  created_at              DateTime? @default(now()) @db.Timestamptz(6)
  updated_at              DateTime? @default(now()) @db.Timestamptz(6)

  orders        orders?                  @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  request       stock_transfer_requests? @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "internal_transfers_request_fk")
  from_facility facilities               @relation("transfers_from", fields: [from_facility_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  to_facility   facilities               @relation("transfers_to", fields: [to_facility_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([order_id], map: "idx_internal_transfers_order_id")
  @@index([from_facility_id], map: "idx_internal_transfers_from")
  @@index([to_facility_id], map: "idx_internal_transfers_to")
  @@index([status], map: "idx_internal_transfers_status")
}

model stock_transfer_requests {
  id               Int       @id @default(autoincrement())
  request_code     String    @unique @db.VarChar(40)
  from_facility_id Int
  to_facility_id   Int
  lines            Json
  status           String    @default("REQUESTED") @db.VarChar(20)
  reason           String?
  requested_by     Int
  decided_by       Int?
  decided_at       DateTime? @db.Timestamptz(6)
  decision_note    String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)

  from_facility facilities                      @relation("stock_requests_from", fields: [from_facility_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  to_facility   facilities                      @relation("stock_requests_to", fields: [to_facility_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transfer      internal_transfers?
  events        stock_transfer_request_events[]

  @@index([from_facility_id], map: "idx_stock_transfer_requests_from")
  @@index([to_facility_id], map: "idx_stock_transfer_requests_to")
}

model stock_transfer_request_events {
  id          BigInt   @id @default(autoincrement())
  request_id  Int
  action      String   @db.VarChar(20)
  from_status String?  @db.VarChar(20)
  to_status   String   @db.VarChar(20)
  actor_id    Int
  note        String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  request stock_transfer_requests @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([request_id], map: "idx_stock_transfer_request_events_request")
}

model cart_items {
  id                 Int                 @id @default(autoincrement())
  customer_id        Int?
  variant_id         Int?
  quantity           Int                 @default(1)
  created_at         DateTime?           @default(now()) @db.Timestamptz(6)
  customers          customers?          @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  packaging_variants packaging_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cart_items_variant")

  @@unique([customer_id, variant_id], map: "uq_cart_item")
}

model articles {
  id                    Int                @id @default(autoincrement())
  title                 String             @db.VarChar(255)
  slug                  String             @unique @db.VarChar(255)
  summary               String?
  content               String
  cover_image_url       String?
  cover_image_public_id String?
  category_id           Int?
  author_id             Int?
  author_name           String?            @db.VarChar(255)
  view_count            Int?
  status                String             @default("DRAFT") @db.VarChar(50)
  review_note           String?
  published_at          DateTime?          @db.Timestamptz(6)
  created_at            DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @default(now()) @db.Timestamptz(6)
  users                 employees?         @relation(fields: [author_id], references: [id], onUpdate: NoAction)
  category              article_categories? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  comments              article_comments[]
}

model article_categories {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(100)
  slug     String     @unique @db.VarChar(120)
  articles articles[]
}

model article_comments {
  id          Int                @id @default(autoincrement())
  article_id  Int
  parent_id   Int?
  customer_id Int?
  employee_id Int?
  author_name String             @db.VarChar(255)
  content     String
  status      String             @default("VISIBLE") @db.VarChar(20)
  created_at  DateTime           @default(now()) @db.Timestamptz(6)
  updated_at  DateTime           @default(now()) @db.Timestamptz(6)
  article     articles           @relation(fields: [article_id], references: [id], onDelete: Cascade)
  parent      article_comments?  @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies     article_comments[] @relation("CommentReplies")

  @@index([article_id, created_at], map: "idx_article_comments_article")
}

model purchase_orders {
  id                       Int                     @id @default(autoincrement())
  po_code                  String                  @unique @db.VarChar(50)
  supplier_id              Int?
  supplier_manufacturer_id Int?
  facility_id              Int?
  created_by_employee_id   Int?
  approved_by_id           Int?
  approved_at              DateTime?               @db.Timestamptz(6)
  total_amount             Decimal?                @default(0) @db.Decimal(15, 2)
  status                   String?                 @default("PENDING") @db.VarChar(50)
  note                     String?
  cancel_reason            String?
  closed_reason            String?
  expected_at              DateTime?               @db.Date
  received_at              DateTime?               @db.Timestamptz(6)
  created_at               DateTime?               @default(now()) @db.Timestamptz(6)
  accounts_payable         accounts_payable[]
  cashbook_logs            cashbook_logs[]
  purchase_order_items     purchase_order_items[]
  purchase_order_events    purchase_order_events[]
  goods_receipts           goods_receipts[]
  employees                employees?              @relation(fields: [created_by_employee_id], references: [id], onUpdate: NoAction)
  approved_by              employees?              @relation("po_approver", fields: [approved_by_id], references: [id], onUpdate: NoAction)
  supplier                 facilities?             @relation("po_supplier", fields: [supplier_id], references: [id], onUpdate: NoAction)
  supplier_manufacturer    manufacturers?          @relation(fields: [supplier_manufacturer_id], references: [id], onUpdate: NoAction)
  facility                 facilities?             @relation("po_facility", fields: [facility_id], references: [id], onUpdate: NoAction)

  @@index([status], map: "idx_po_status")
  @@index([supplier_id], map: "idx_po_supplier")
  @@index([facility_id], map: "idx_po_facility")
}

model purchase_order_events {
  id              BigInt          @id @default(autoincrement())
  po_id           Int
  action          String          @db.VarChar(30)
  from_status     String?         @db.VarChar(50)
  to_status       String          @db.VarChar(50)
  actor_id        Int
  note            String?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  purchase_orders purchase_orders @relation(fields: [po_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor           employees       @relation("po_event_actor", fields: [actor_id], references: [id], onUpdate: NoAction)

  @@index([po_id], map: "idx_po_events_po")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model goods_receipts {
  id                        Int                         @id @default(autoincrement())
  receipt_code              String                      @unique @db.VarChar(50)
  po_id                     Int
  facility_id               Int
  received_by_id            Int
  received_at               DateTime                    @default(now()) @db.Timestamptz(6)
  note                      String?
  purchase_orders           purchase_orders             @relation(fields: [po_id], references: [id], onUpdate: NoAction)
  facility                  facilities                  @relation("gr_facility", fields: [facility_id], references: [id], onUpdate: NoAction)
