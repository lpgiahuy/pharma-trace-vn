PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://app_user:<password>@localhost:5433/phartrace-vn-db?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# Enable only after explicit account RLS activation and dependent modules are ready.
AUTH_RLS_ENABLED=false
QR_SECRET_KEY="pharmatrace-vn-fallback-secret-qr-key-2026"
FACTORY_BATCH_MAX_BOXES=10000
API_GEMINI="your_gemini_api_key_here"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Medicine assistant (RAG). API_GEMINI above is the key; the rest are optional overrides.
# GEMINI_CHAT_MODEL="gemini-2.5-flash"
# GEMINI_CHAT_FALLBACK_MODEL="gemini-2.5-flash"   # used when the main model is overloaded
# GEMINI_EMBED_MODEL="gemini-embedding-001"   # gemini-embedding-2 also works and has its own free-tier quota
# GEMINI_EMBED_DIMENSIONS=768
# CHATBOT_MIN_SCORE=0.45
