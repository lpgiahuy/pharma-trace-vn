# PostgreSQL Docker Container Configuration
DB_PASSWORD=replace-with-a-local-secret
DB_PORT=5433
DB_NAME=phartrace-vn-db
APP_DB_PASSWORD=replace-with-a-local-secret

# Backend / app (read by docker-compose.yml; APP_DB_PASSWORD must be URL-safe)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
QR_SECRET_KEY=replace-with-a-random-secret
AUTH_RLS_ENABLED=false
CORS_ORIGINS=http://localhost
HTTP_PORT=80
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
API_GEMINI=
# GEMINI_CHAT_MODEL=
# GEMINI_CHAT_FALLBACK_MODEL=
# GEMINI_EMBED_MODEL=
# GEMINI_EMBED_DIMENSIONS=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
